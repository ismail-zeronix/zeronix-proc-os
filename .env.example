# --- Database (docker compose "db" service publishes on 5433) ---
POSTGRES_USER=zeronix
POSTGRES_PASSWORD=zeronix
POSTGRES_DB=procurement
DATABASE_URL=postgres://zeronix:zeronix@localhost:5433/procurement

# --- Auth: long random string, e.g. `openssl rand -base64 32` ---
AUTH_SECRET=replace-me-with-a-long-random-string
ADMIN_EMAIL=admin@zeronix.local
ADMIN_PASSWORD=ChangeMe123!

# --- Local LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
# qwen3.5:4b (~3.4 GB) best accuracy on CPU; qwen3.5:2b (~2.7 GB) faster
LLM_MODEL=qwen3.5:4b
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=5m

# Run the background parse worker inside the Next.js server process
RUN_WORKER=true

# Docker only
WEB_PORT=3100
DB_PORT=5433
# DOCKER_OLLAMA_URL=http://ollama:11434   # when using `--profile ollama`
OLLAMA_MEM_LIMIT=6g

# Nightly backups (docker compose --profile backup up -d) keep this many days
BACKUP_KEEP_DAYS=14
