# ZeronixOS environment. Copy to .env and fill in. Placeholders only: never commit a real .env.
#   Local development:  cp .env.example .env   (values below work with the local docker-compose.yml database)
#   Production server:  /srv/docker/zeronix/.env, values marked [prod] must be changed (see production/README.md)

# ===================== App =====================
# [prod] uncomment so plain `docker compose ...` uses the production file on the server
# COMPOSE_FILE=docker-compose.prod.yml
# Image tag built by production/deploy.sh; leave unset (defaults to "latest")
# APP_IMAGE_TAG=latest
# Run the background schedulers (mail sync, feeds, AI queue) inside the Next.js server process
RUN_WORKER=true
# Uploaded files (Files app). Local default: ./data/files. Production uses a Docker volume at /app/data/files
# FILES_DIR=./data/files

# ===================== Database (PostgreSQL) =====================
# [prod] use a long random URL-safe password, e.g. `openssl rand -hex 24` (it is embedded in DATABASE_URL)
POSTGRES_USER=zeronix
POSTGRES_PASSWORD=zeronix
POSTGRES_DB=procurement
# Local only: the app on your machine talks to the docker "db" service on 5433.
# In production the compose file builds DATABASE_URL itself from the three values above.
DATABASE_URL=postgres://zeronix:zeronix@localhost:5433/procurement
# DB_POOL_MAX=10

# ===================== Authentication / Security =====================
# [prod] long random string: `openssl rand -base64 32`. Also the key for saved mailbox passwords:
# changing it later logs everyone out and saved mailbox passwords must be entered again.
AUTH_SECRET=replace-me-with-a-long-random-string
# true when served over HTTPS (production default is true)
COOKIE_SECURE=false
# No admin credentials here: on a fresh database the portal opens /setup, where the first administrator is created.

# ===================== Email (users connect their own mailbox under My account) =====================
# MAIL_IMAP_HOST=imap.hostinger.com
# MAIL_IMAP_PORT=993
# MAIL_SMTP_HOST=smtp.hostinger.com
# MAIL_SMTP_PORT=465
# MAIL_DAILY_LIMIT=200        # most recipients one person can email per 24 hours
# MAIL_WEBMAIL_URL=https://mail.hostinger.com

# ===================== Storage / PDF =====================
# Browser used to make PDFs; the Docker image sets it. Locally Edge/Chrome are found automatically.
# CHROMIUM_PATH=/usr/bin/chromium-browser
# Where the server reaches itself to print PDFs (default http://127.0.0.1:$PORT)
# INTERNAL_URL=http://127.0.0.1:3000

# ===================== External APIs: AI =====================
# Production will use a hosted AI model API (not wired up yet). Conversation memory and context stay in the
# application's own PostgreSQL database; the provider only receives each request.
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
#
# Local only: Ollama on this machine (not used on the production server)
OLLAMA_URL=http://localhost:11434
# qwen3.5:4b (~3.4 GB) best accuracy on CPU; qwen3.5:2b (~2.7 GB) faster
LLM_MODEL=qwen3.5:4b
LLM_NUM_CTX=4096
LLM_KEEP_ALIVE=1m

# ===================== Redis =====================
# Not used. Background jobs run in-process and chat uses PostgreSQL LISTEN/NOTIFY.

# ===================== Local Docker stack only (docker-compose.yml) =====================
WEB_PORT=3100
DB_PORT=5433
# DOCKER_OLLAMA_URL=http://ollama:11434   # when using `--profile ollama`
OLLAMA_MEM_LIMIT=6g
# Nightly backups (docker compose --profile backup up -d) keep this many days
BACKUP_KEEP_DAYS=14

# ===================== Production backups (production/backup-postgres.sh) =====================
# BACKUP_DIR=/srv/backups/zeronix
# BACKUP_KEEP_DAYS=14
