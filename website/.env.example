# zeronixtech.com site. Copy to .env.local for `npm run dev`; in production the compose file sets these.
# The portal's address the site reads from (production: http://zeronix-app:3000 over site-net)
PORTAL_INTERNAL_URL=http://localhost:3101
# Same value as SITE_API_KEY on the portal (openssl rand -hex 24)
SITE_API_KEY=replace-with-the-same-key-as-the-portal
# Same value as REVALIDATE_SECRET on the portal (openssl rand -hex 24)
REVALIDATE_SECRET=replace-with-the-same-secret-as-the-portal
SITE_URL=https://zeronixtech.com
# true only at go-live: lets search engines index the site
SITE_INDEXING=false
# the shop (WEBSITE-PLAN.md section 11); stays false for now
COMMERCE_ENABLED=false
# Where browsers load the chat widget (the portal public address); compose sets it
# PORTAL_PUBLIC_URL=http://localhost:3200
